    subX: 32
    subY: 40
  # DX: extra tile markers (kept as a separate set so the stock Pathfinding sheet's frame
  # numbering stays untouched; layout constants in Map.cpp Pathfinding2Markers). One marker
  # type per COLUMN (row 0 = solid, row 1 = dithered): column 0 = full-tile outline (dithered:
  # overwatch watched tiles), column 1 = crossed tile (unused), column 2 = target marker
  # (solid: motion-detector reading), column 3 = X "no" marker (dithered: overwatch dead zones).
  - type: Pathfinding2
    files:
      0: Resources/Pathfinding/Pathfinding2.png
    width: 128
    height: 80
    subX: 32
    subY: 40
