# =====================================================================
#  DX: Soldier Roles (xcom1)
# =====================================================================
#  All role content for the UFO ruleset lives here: the role-icon surfaces
#  now, and later the `roleIcons:` registry + the `roles:` seed list.
#
#  Role icons are individual named single-image surfaces, referenced BY NAME
#  from a `roleIcons:` registry entry (which a Role then references by the
#  registry name). Using named surfaces instead of a numbered SurfaceSet makes
#  the icon identity a stable string - no frame indices, no per-mod sprite
#  offsets, no shared-frame boundary - so a saved role's icon survives mod-list
#  / load-order changes, and a mod adds icons just by declaring more named
#  surfaces (namespacing the name avoids collisions).
#
#  Two variants per role:
#    RoleIcon<Name>     - the full 23x23 badge (inventory + battlescape stats bar).
#    RoleIcon<Name>Map  - the small marker that replaces the bobbing down-arrow
#                         selected-unit indicator in the live battlescape
#                         (variable size). "None" has a badge but no Map marker
#                         (the None role keeps the default arrow).
#
#  Each surface keeps its PNG's native size (loadImage reallocates), so no
#  width/height is needed.
# =====================================================================
extraSprites:
  - typeSingle: RoleIconNone
    fileSingle: Resources/Roles/RoleIconNone.png
  - typeSingle: RoleIconInfantry
    fileSingle: Resources/Roles/RoleIconInfantry.png
  - typeSingle: RoleIconInfantryMap
    fileSingle: Resources/Roles/RoleIconInfantryMap.png
  - typeSingle: RoleIconMarksman
    fileSingle: Resources/Roles/RoleIconMarksman.png
  - typeSingle: RoleIconMarksmanMap
    fileSingle: Resources/Roles/RoleIconMarksmanMap.png
  - typeSingle: RoleIconSniper
    fileSingle: Resources/Roles/RoleIconSniper.png
  - typeSingle: RoleIconSniperMap
    fileSingle: Resources/Roles/RoleIconSniperMap.png
  - typeSingle: RoleIconScout
    fileSingle: Resources/Roles/RoleIconScout.png
  - typeSingle: RoleIconScoutMap
    fileSingle: Resources/Roles/RoleIconScoutMap.png
  - typeSingle: RoleIconAssault
    fileSingle: Resources/Roles/RoleIconAssault.png
  - typeSingle: RoleIconAssaultMap
    fileSingle: Resources/Roles/RoleIconAssaultMap.png
  - typeSingle: RoleIconMachineGunner
    fileSingle: Resources/Roles/RoleIconMachineGunner.png
  - typeSingle: RoleIconMachineGunnerMap
    fileSingle: Resources/Roles/RoleIconMachineGunnerMap.png
  - typeSingle: RoleIconHeavy
    fileSingle: Resources/Roles/RoleIconHeavy.png
  - typeSingle: RoleIconHeavyMap
    fileSingle: Resources/Roles/RoleIconHeavyMap.png
  - typeSingle: RoleIconAntiArmor
    fileSingle: Resources/Roles/RoleIconAntiArmor.png
  - typeSingle: RoleIconAntiArmorMap
    fileSingle: Resources/Roles/RoleIconAntiArmorMap.png
  - typeSingle: RoleIconRocketeer
    fileSingle: Resources/Roles/RoleIconRocketeer.png
  - typeSingle: RoleIconRocketeerMap
    fileSingle: Resources/Roles/RoleIconRocketeerMap.png
  - typeSingle: RoleIconGrenadier
    fileSingle: Resources/Roles/RoleIconGrenadier.png
  - typeSingle: RoleIconGrenadierMap
    fileSingle: Resources/Roles/RoleIconGrenadierMap.png
  - typeSingle: RoleIconDemolitions
    fileSingle: Resources/Roles/RoleIconDemolitions.png
  - typeSingle: RoleIconDemolitionsMap
    fileSingle: Resources/Roles/RoleIconDemolitionsMap.png
  - typeSingle: RoleIconMedic
    fileSingle: Resources/Roles/RoleIconMedic.png
  - typeSingle: RoleIconMedicMap
    fileSingle: Resources/Roles/RoleIconMedicMap.png
  - typeSingle: RoleIconPsionics
    fileSingle: Resources/Roles/RoleIconPsionics.png
  - typeSingle: RoleIconPsionicsMap
    fileSingle: Resources/Roles/RoleIconPsionicsMap.png
  - typeSingle: RoleIconSpecialist
    fileSingle: Resources/Roles/RoleIconSpecialist.png
  - typeSingle: RoleIconSpecialistMap
    fileSingle: Resources/Roles/RoleIconSpecialistMap.png

# =====================================================================
#  Role-icon registry
#  Each entry bundles a badge + battlescape map-marker surface under a
#  stable name. A role (below, and player-created ones) references an icon
#  by this name; the picker enumerates this list. NONE is the "no role"
#  badge - it has no map marker (an unassigned unit keeps the default arrow).
# =====================================================================
roleIcons:
  - name: NONE
    sprite: RoleIconNone
  - name: INFANTRY
    sprite: RoleIconInfantry
    mapSprite: RoleIconInfantryMap
  - name: MARKSMAN
    sprite: RoleIconMarksman
    mapSprite: RoleIconMarksmanMap
  - name: SNIPER
    sprite: RoleIconSniper
    mapSprite: RoleIconSniperMap
  - name: SCOUT
    sprite: RoleIconScout
    mapSprite: RoleIconScoutMap
  - name: ASSAULT
    sprite: RoleIconAssault
    mapSprite: RoleIconAssaultMap
  - name: MACHINE_GUNNER
    sprite: RoleIconMachineGunner
    mapSprite: RoleIconMachineGunnerMap
  - name: HEAVY
    sprite: RoleIconHeavy
    mapSprite: RoleIconHeavyMap
  - name: ANTI_ARMOR
    sprite: RoleIconAntiArmor
    mapSprite: RoleIconAntiArmorMap
  - name: ROCKETEER
    sprite: RoleIconRocketeer
    mapSprite: RoleIconRocketeerMap
  - name: GRENADIER
    sprite: RoleIconGrenadier
    mapSprite: RoleIconGrenadierMap
  - name: DEMOLITIONS
    sprite: RoleIconDemolitions
    mapSprite: RoleIconDemolitionsMap
  - name: MEDIC
    sprite: RoleIconMedic
    mapSprite: RoleIconMedicMap
  - name: PSIONICS
    sprite: RoleIconPsionics
    mapSprite: RoleIconPsionicsMap
  - name: SPECIALIST
    sprite: RoleIconSpecialist
    mapSprite: RoleIconSpecialistMap

# =====================================================================
#  Default seed roles
#  Copied into a NEW game's editable role list (SavedGame). Thereafter the
#  player creates / renames / re-icons / recolors / deletes freely. Seeds
#  carry identity only - no loadout (the player fills that in-game) and no
#  color (these stock icons aren't intended for armor recolour; revisit
#  with Per-Role Armor Colors).
# =====================================================================
roles:
  - name: STR_ROLE_INFANTRY
    shortName: INF
    icon: INFANTRY
  - name: STR_ROLE_MARKSMAN
    shortName: MRK
    icon: MARKSMAN
  - name: STR_ROLE_SNIPER
    shortName: SNP
    icon: SNIPER
  - name: STR_ROLE_SCOUT
    shortName: SCT
    icon: SCOUT
  - name: STR_ROLE_ASSAULT
    shortName: ASL
    icon: ASSAULT
  - name: STR_ROLE_MACHINE_GUNNER
    shortName: MGN
    icon: MACHINE_GUNNER
  - name: STR_ROLE_HEAVY
    shortName: HVY
    icon: HEAVY
  - name: STR_ROLE_ANTI_ARMOR
    shortName: AAR
    icon: ANTI_ARMOR
  - name: STR_ROLE_ROCKETEER
    shortName: RKT
    icon: ROCKETEER
  - name: STR_ROLE_GRENADIER
    shortName: GRN
    icon: GRENADIER
  - name: STR_ROLE_DEMOLITIONS
    shortName: DEM
    icon: DEMOLITIONS
  - name: STR_ROLE_MEDIC
    shortName: MED
    icon: MEDIC
  - name: STR_ROLE_PSIONICS
    shortName: PSI
    icon: PSIONICS
  - name: STR_ROLE_SPECIALIST
    shortName: SPC
    icon: SPECIALIST

# =====================================================================
#  Seed-role display names (mod content). Player-created roles use raw
#  typed text instead; these STR ids localise the shipped defaults.
# =====================================================================
extraStrings:
  - type: en-US
    strings:
      STR_ROLE_INFANTRY: "Infantry"
      STR_ROLE_MARKSMAN: "Designated Marksman"
      STR_ROLE_SNIPER: "Sniper"
      STR_ROLE_SCOUT: "Scout"
      STR_ROLE_ASSAULT: "Assault"
      STR_ROLE_MACHINE_GUNNER: "Machine Gunner"
      STR_ROLE_HEAVY: "Heavy Weapons"
      STR_ROLE_ANTI_ARMOR: "Anti-Armor"
      STR_ROLE_ROCKETEER: "Rocket Trooper"
      STR_ROLE_GRENADIER: "Grenadier"
      STR_ROLE_DEMOLITIONS: "Demolitions"
      STR_ROLE_MEDIC: "Medic"
      STR_ROLE_PSIONICS: "Psion"
      STR_ROLE_SPECIALIST: "Specialist"
