  - typeSingle: RoleIconBoltMap
    fileSingle: Resources/DX/Roles/RoleIconBoltMap.png

# =====================================================================
#  Role-icon registry
#  Each entry bundles a badge + battlescape map-marker surface under a
#  stable name. A role (below, and player-created ones) references an icon
#  by this name; the picker enumerates this list. NONE is the "no role"
#  badge - it has no map marker (an unassigned unit keeps the default arrow).
# =====================================================================
  # DX stealth: an eye with a slash through it - "unseen".
  - typeSingle: RoleIconSlashedEye
    fileSingle: Resources/DX/Roles/RoleIconSlashedEye.png
  - typeSingle: RoleIconSlashedEyeMap
    fileSingle: Resources/DX/Roles/RoleIconSlashedEyeMap.png

  # DX heavy weapons: a heavy shell (large-calibre ordnance).
  - typeSingle: RoleIconShell
    fileSingle: Resources/DX/Roles/RoleIconShell.png
  - typeSingle: RoleIconShellMap
    fileSingle: Resources/DX/Roles/RoleIconShellMap.png

roleIcons:
  - name: NONE
    sprite: RoleIconNone
  - name: RIFLE
    sprite: RoleIconRifle
    mapSprite: RoleIconRifleMap
  - name: SCOPED_RIFLE
    sprite: RoleIconScopedRifle
    mapSprite: RoleIconScopedRifleMap
  - name: CROSSHAIR
    sprite: RoleIconCrosshair
    mapSprite: RoleIconCrosshairMap
  - name: BINOCULARS
    sprite: RoleIconBinoculars
    mapSprite: RoleIconBinocularsMap
  - name: SHOTGUN
    sprite: RoleIconShotgun
    mapSprite: RoleIconShotgunMap
  - name: AMMO_BELT
    sprite: RoleIconAmmoBelt
    mapSprite: RoleIconAmmoBeltMap
  - name: FIST
    sprite: RoleIconFist
    mapSprite: RoleIconFistMap
  - name: BROKEN_SHIELD
    sprite: RoleIconBrokenShield
    mapSprite: RoleIconBrokenShieldMap
  - name: ROCKET
    sprite: RoleIconRocket
    mapSprite: RoleIconRocketMap
  - name: GRENADE
    sprite: RoleIconGrenade
    mapSprite: RoleIconGrenadeMap
  - name: BOMB
    sprite: RoleIconBomb
    mapSprite: RoleIconBombMap
  - name: MEDICAL_CROSS
    sprite: RoleIconMedicalCross
    mapSprite: RoleIconMedicalCrossMap
  - name: WAVES
    sprite: RoleIconWaves
    mapSprite: RoleIconWavesMap
  - name: BOLT
    sprite: RoleIconBolt
    mapSprite: RoleIconBoltMap

# =====================================================================
#  Default seed roles
#  Copied into a NEW game's editable role list (SavedGame). Thereafter the
#  player creates / renames / re-icons / recolors / deletes freely. Seeds
#  carry identity only - no loadout (the player fills that in-game).
#  Default armor colours follow the legacy DX assignments (battlescape
#  palette block bases; see RoleColorSelectState for the name<->value map).
#  Anti-Armor / Demolitions / Specialist ship uncoloured, as in legacy.
# =====================================================================
  - name: SLASHED_EYE
    sprite: RoleIconSlashedEye
    mapSprite: RoleIconSlashedEyeMap

  - name: SHELL
    sprite: RoleIconShell
    mapSprite: RoleIconShellMap

roles:
  - name: STR_ROLE_INFANTRY
    shortName: INF
    icon: RIFLE
    color: 208           # Blue
