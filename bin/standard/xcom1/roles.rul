# =====================================================================
#  Soldier armor colours (legacy soldierArmorBaseColors, UFO values).
#  The picker's colour set for role armor recolouring. Values are
#  battlescape-palette indices, so they are palette-dependent and belong
#  here, not in code (TFTD needs its own set). The value's block replaces
#  the armor's accent block; its low nibble selects the recolor mode:
#  1 = lighten, 15 = darken (dark half of the ramp), else plain offset.
#  Order here is the picker's display order; mods can retune by name.
# =====================================================================
soldierArmorBaseColors:
  - name: STR_COLOR_WHITE
    color: 1
  - name: STR_COLOR_GRAY
    color: 0
  - name: STR_COLOR_BLACK
    color: 15
  - name: STR_COLOR_LIGHT_RED
    color: 33
  - name: STR_COLOR_RED
    color: 32
  - name: STR_COLOR_DARK_RED
    color: 47
  - name: STR_COLOR_ORANGE
    color: 17
  - name: STR_COLOR_YELLOW
    color: 145
  - name: STR_COLOR_LIGHT_GREEN
    color: 65
  - name: STR_COLOR_GREEN
    color: 64
  - name: STR_COLOR_DARK_GREEN
    color: 79
  - name: STR_COLOR_BLUE_GREEN
    color: 48
  - name: STR_COLOR_LIGHT_BLUE
    color: 129
  - name: STR_COLOR_BLUE
    color: 208
  - name: STR_COLOR_NAVY
    color: 223
  - name: STR_COLOR_LIGHT_PURPLE
    color: 193
  - name: STR_COLOR_PURPLE
    color: 192
  - name: STR_COLOR_DARK_PURPLE
    color: 207
  - name: STR_COLOR_METALLIC
    color: 224
  - name: STR_COLOR_PINK
    color: 177
  - name: STR_COLOR_BEIGE
    color: 80
  - name: STR_COLOR_BROWN
    color: 160

# =====================================================================
#  Armor accent blocks for role armor colours.
#  spriteUtileGroup declares which 16-colour palette block is an armor's
#  "accent": when a soldier's role has an armor colour set, pixels in that
#  block are remapped into the role colour's block on the battlescape sprite
#  and the inventory paperdoll (the colour's low nibble darkens the ramp,
#  clamped at the block end - legacy DX semantics). No spriteUtileColor is
#  set, so armors render stock when the role has no colour.
#
#  Blocks measured from the actual sprite sheets (non-face/hair pixels):
#    XCOM_0 jumpsuit      -> block  5 (93%)   MAN_0 paperdolls match (78%)
#    XCOM_1 personal      -> block 14 (98%)   MAN_1 paperdolls match (87%)
#    XCOM_2 power/flying  -> block  5 (99%)   MAN_2 paperdoll matches (95%)
#  Note: vanilla suits are essentially single-block, so the "accent" is
#  the whole suit body; face/hair/highlights keep their own blocks.
# =====================================================================
armors:
  - type: STR_NONE_UC
    spriteUtileGroup: 5
  - type: STR_PERSONAL_ARMOR_UC
    spriteUtileGroup: 14
  - type: STR_POWER_SUIT_UC
    spriteUtileGroup: 5
  - type: STR_FLYING_SUIT_UC
    spriteUtileGroup: 5

# Seed-role display names live in Language/DX/en-US.yml (shared with xcom2).
