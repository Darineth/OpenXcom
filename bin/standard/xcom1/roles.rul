# =====================================================================
#  DX: Soldier Roles (xcom1)
# =====================================================================
#  All role content for the UFO ruleset lives here: the role-icon surfaces,
#  the `roleIcons:` registry, armor colours, and the `roles:` seed list.
#  The icon art lives in this mod's Resources/DX/Roles (UFO-palette indexed);
#  xcom2 carries its own TFTD-palette-indexed copy.
#
#  Role icons are individual named single-image surfaces, referenced BY NAME
#  from a `roleIcons:` registry entry (which a Role then references by the
#  registry name). Using named surfaces instead of a numbered SurfaceSet makes
#  the icon identity a stable string - no frame indices, no per-mod sprite
#  offsets, no shared-frame boundary - so a saved role's icon survives mod-list
#  / load-order changes, and a mod adds icons just by declaring more named
#  surfaces (namespacing the name avoids collisions).
#
#  Two variants per role:
#    RoleIcon<Name>     - the full 23x23 badge (inventory + battlescape stats bar).
#    RoleIcon<Name>Map  - the small marker that replaces the bobbing down-arrow
#                         selected-unit indicator in the live battlescape
#                         (variable size). "None" has a badge but no Map marker
#                         (the None role keeps the default arrow).
#
#  Each surface keeps its PNG's native size (loadImage reallocates), so no
#  width/height is needed.
# =====================================================================
extraSprites:
  - typeSingle: RoleIconNone
    fileSingle: Resources/DX/Roles/RoleIconNone.png
  - typeSingle: RoleIconInfantry
    fileSingle: Resources/DX/Roles/RoleIconInfantry.png
  - typeSingle: RoleIconInfantryMap
    fileSingle: Resources/DX/Roles/RoleIconInfantryMap.png
  - typeSingle: RoleIconMarksman
    fileSingle: Resources/DX/Roles/RoleIconMarksman.png
  - typeSingle: RoleIconMarksmanMap
    fileSingle: Resources/DX/Roles/RoleIconMarksmanMap.png
  - typeSingle: RoleIconSniper
    fileSingle: Resources/DX/Roles/RoleIconSniper.png
  - typeSingle: RoleIconSniperMap
    fileSingle: Resources/DX/Roles/RoleIconSniperMap.png
  - typeSingle: RoleIconScout
    fileSingle: Resources/DX/Roles/RoleIconScout.png
  - typeSingle: RoleIconScoutMap
    fileSingle: Resources/DX/Roles/RoleIconScoutMap.png
  - typeSingle: RoleIconAssault
    fileSingle: Resources/DX/Roles/RoleIconAssault.png
  - typeSingle: RoleIconAssaultMap
    fileSingle: Resources/DX/Roles/RoleIconAssaultMap.png
  - typeSingle: RoleIconMachineGunner
    fileSingle: Resources/DX/Roles/RoleIconMachineGunner.png
  - typeSingle: RoleIconMachineGunnerMap
    fileSingle: Resources/DX/Roles/RoleIconMachineGunnerMap.png
  - typeSingle: RoleIconHeavy
    fileSingle: Resources/DX/Roles/RoleIconHeavy.png
  - typeSingle: RoleIconHeavyMap
    fileSingle: Resources/DX/Roles/RoleIconHeavyMap.png
  - typeSingle: RoleIconAntiArmor
    fileSingle: Resources/DX/Roles/RoleIconAntiArmor.png
  - typeSingle: RoleIconAntiArmorMap
    fileSingle: Resources/DX/Roles/RoleIconAntiArmorMap.png
  - typeSingle: RoleIconRocketeer
    fileSingle: Resources/DX/Roles/RoleIconRocketeer.png
  - typeSingle: RoleIconRocketeerMap
    fileSingle: Resources/DX/Roles/RoleIconRocketeerMap.png
  - typeSingle: RoleIconGrenadier
    fileSingle: Resources/DX/Roles/RoleIconGrenadier.png
  - typeSingle: RoleIconGrenadierMap
    fileSingle: Resources/DX/Roles/RoleIconGrenadierMap.png
  - typeSingle: RoleIconDemolitions
    fileSingle: Resources/DX/Roles/RoleIconDemolitions.png
  - typeSingle: RoleIconDemolitionsMap
    fileSingle: Resources/DX/Roles/RoleIconDemolitionsMap.png
  - typeSingle: RoleIconMedic
    fileSingle: Resources/DX/Roles/RoleIconMedic.png
  - typeSingle: RoleIconMedicMap
    fileSingle: Resources/DX/Roles/RoleIconMedicMap.png
  - typeSingle: RoleIconPsionics
    fileSingle: Resources/DX/Roles/RoleIconPsionics.png
  - typeSingle: RoleIconPsionicsMap
    fileSingle: Resources/DX/Roles/RoleIconPsionicsMap.png
  - typeSingle: RoleIconSpecialist
    fileSingle: Resources/DX/Roles/RoleIconSpecialist.png
  - typeSingle: RoleIconSpecialistMap
    fileSingle: Resources/DX/Roles/RoleIconSpecialistMap.png

# =====================================================================
#  Role-icon registry
#  Each entry bundles a badge + battlescape map-marker surface under a
#  stable name. A role (below, and player-created ones) references an icon
#  by this name; the picker enumerates this list. NONE is the "no role"
#  badge - it has no map marker (an unassigned unit keeps the default arrow).
# =====================================================================
roleIcons:
  - name: NONE
    sprite: RoleIconNone
  - name: INFANTRY
    sprite: RoleIconInfantry
    mapSprite: RoleIconInfantryMap
  - name: MARKSMAN
    sprite: RoleIconMarksman
    mapSprite: RoleIconMarksmanMap
  - name: SNIPER
    sprite: RoleIconSniper
    mapSprite: RoleIconSniperMap
  - name: SCOUT
    sprite: RoleIconScout
    mapSprite: RoleIconScoutMap
  - name: ASSAULT
    sprite: RoleIconAssault
    mapSprite: RoleIconAssaultMap
  - name: MACHINE_GUNNER
    sprite: RoleIconMachineGunner
    mapSprite: RoleIconMachineGunnerMap
  - name: HEAVY
    sprite: RoleIconHeavy
    mapSprite: RoleIconHeavyMap
  - name: ANTI_ARMOR
    sprite: RoleIconAntiArmor
    mapSprite: RoleIconAntiArmorMap
  - name: ROCKETEER
    sprite: RoleIconRocketeer
    mapSprite: RoleIconRocketeerMap
  - name: GRENADIER
    sprite: RoleIconGrenadier
    mapSprite: RoleIconGrenadierMap
  - name: DEMOLITIONS
    sprite: RoleIconDemolitions
    mapSprite: RoleIconDemolitionsMap
  - name: MEDIC
    sprite: RoleIconMedic
    mapSprite: RoleIconMedicMap
  - name: PSIONICS
    sprite: RoleIconPsionics
    mapSprite: RoleIconPsionicsMap
  - name: SPECIALIST
    sprite: RoleIconSpecialist
    mapSprite: RoleIconSpecialistMap

# =====================================================================
#  Default seed roles
#  Copied into a NEW game's editable role list (SavedGame). Thereafter the
#  player creates / renames / re-icons / recolors / deletes freely. Seeds
#  carry identity only - no loadout (the player fills that in-game).
#  Default armor colours follow the legacy DX assignments (battlescape
#  palette block bases; see RoleColorSelectState for the name<->value map).
#  Anti-Armor / Demolitions / Specialist ship uncoloured, as in legacy.
# =====================================================================
roles:
  - name: STR_ROLE_INFANTRY
    shortName: INF
    icon: INFANTRY
    color: 208           # Blue
  - name: STR_ROLE_MARKSMAN
    shortName: MRK
    icon: MARKSMAN
    color: 0             # Gray
  - name: STR_ROLE_SNIPER
    shortName: SNP
    icon: SNIPER
    color: 15            # Black
  - name: STR_ROLE_SCOUT
    shortName: SCT
    icon: SCOUT
    color: 145           # Yellow
  - name: STR_ROLE_ASSAULT
    shortName: ASL
    icon: ASSAULT
    color: 193           # Light Purple
  - name: STR_ROLE_MACHINE_GUNNER
    shortName: MGN
    icon: MACHINE_GUNNER
    color: 79            # Dark Green
  - name: STR_ROLE_HEAVY
    shortName: HVY
    icon: HEAVY
    color: 160           # Brown
  - name: STR_ROLE_ANTI_ARMOR
    shortName: AAR
    icon: ANTI_ARMOR
  - name: STR_ROLE_ROCKETEER
    shortName: RKT
    icon: ROCKETEER
    color: 32            # Red
  - name: STR_ROLE_GRENADIER
    shortName: GRN
    icon: GRENADIER
    color: 17            # Orange
  - name: STR_ROLE_DEMOLITIONS
    shortName: DEM
    icon: DEMOLITIONS
  - name: STR_ROLE_MEDIC
    shortName: MED
    icon: MEDIC
    color: 1             # White
  - name: STR_ROLE_PSIONICS
    shortName: PSI
    icon: PSIONICS
    color: 192           # Purple
  - name: STR_ROLE_SPECIALIST
    shortName: SPC
    icon: SPECIALIST

# =====================================================================
#  Soldier armor colours (legacy soldierArmorBaseColors, UFO values).
#  The picker's colour set for role armor recolouring. Values are
#  battlescape-palette indices, so they are palette-dependent and belong
#  here, not in code (TFTD needs its own set). The value's block replaces
#  the armor's accent block; its low nibble selects the recolor mode:
#  1 = lighten, 15 = darken (dark half of the ramp), else plain offset.
#  Order here is the picker's display order; mods can retune by name.
# =====================================================================
soldierArmorBaseColors:
  - name: STR_COLOR_WHITE
    color: 1
  - name: STR_COLOR_GRAY
    color: 0
  - name: STR_COLOR_BLACK
    color: 15
  - name: STR_COLOR_LIGHT_RED
    color: 33
  - name: STR_COLOR_RED
    color: 32
  - name: STR_COLOR_DARK_RED
    color: 47
  - name: STR_COLOR_ORANGE
    color: 17
  - name: STR_COLOR_YELLOW
    color: 145
  - name: STR_COLOR_LIGHT_GREEN
    color: 65
  - name: STR_COLOR_GREEN
    color: 64
  - name: STR_COLOR_DARK_GREEN
    color: 79
  - name: STR_COLOR_BLUE_GREEN
    color: 48
  - name: STR_COLOR_LIGHT_BLUE
    color: 129
  - name: STR_COLOR_BLUE
    color: 208
  - name: STR_COLOR_NAVY
    color: 223
  - name: STR_COLOR_LIGHT_PURPLE
    color: 193
  - name: STR_COLOR_PURPLE
    color: 192
  - name: STR_COLOR_DARK_PURPLE
    color: 207
  - name: STR_COLOR_METALLIC
    color: 224
  - name: STR_COLOR_PINK
    color: 177
  - name: STR_COLOR_BEIGE
    color: 80
  - name: STR_COLOR_BROWN
    color: 160

# =====================================================================
#  Armor accent blocks for role armor colours.
#  spriteUtileGroup declares which 16-colour palette block is an armor's
#  "accent": when a soldier's role has an armor colour set, pixels in that
#  block are remapped into the role colour's block on the battlescape sprite
#  and the inventory paperdoll (the colour's low nibble darkens the ramp,
#  clamped at the block end - legacy DX semantics). No spriteUtileColor is
#  set, so armors render stock when the role has no colour.
#
#  Blocks measured from the actual sprite sheets (non-face/hair pixels):
#    XCOM_0 jumpsuit      -> block  5 (93%)   MAN_0 paperdolls match (78%)
#    XCOM_1 personal      -> block 14 (98%)   MAN_1 paperdolls match (87%)
#    XCOM_2 power/flying  -> block  5 (99%)   MAN_2 paperdoll matches (95%)
#  Note: vanilla suits are essentially single-block, so the "accent" is
#  the whole suit body; face/hair/highlights keep their own blocks.
# =====================================================================
armors:
  - type: STR_NONE_UC
    spriteUtileGroup: 5
  - type: STR_PERSONAL_ARMOR_UC
    spriteUtileGroup: 14
  - type: STR_POWER_SUIT_UC
    spriteUtileGroup: 5
  - type: STR_FLYING_SUIT_UC
    spriteUtileGroup: 5

# Seed-role display names live in Language/DX/en-US.yml (shared with xcom2).
