# =====================================================================
#  DX: Soldier Roles (xcom2 / TFTD)
# =====================================================================
#  TFTD counterpart of xcom1/roles.rul. The role-icon art lives in this
#  mod's Resources/DX/Roles, re-indexed against the TFTD tactical palette
#  (master art: reference/RoleIconsMerged.pdn/.png). Colour values are
#  TFTD tactical-palette indices (a different block layout than UFO), so
#  this file carries its own soldierArmorBaseColors set, armor accent
#  groups, and seed colours.
#
#  Icon names describe WHAT THEY DEPICT (RIFLE, CROSSHAIR, MEDICAL_CROSS...),
#  not the role using them - see xcom1/roles.rul for why.
# =====================================================================
extraSprites:
  - typeSingle: RoleIconNone
    fileSingle: Resources/DX/Roles/RoleIconNone.png
  - typeSingle: RoleIconRifle
    fileSingle: Resources/DX/Roles/RoleIconRifle.png
  - typeSingle: RoleIconRifleMap
    fileSingle: Resources/DX/Roles/RoleIconRifleMap.png
  - typeSingle: RoleIconScopedRifle
    fileSingle: Resources/DX/Roles/RoleIconScopedRifle.png
  - typeSingle: RoleIconScopedRifleMap
    fileSingle: Resources/DX/Roles/RoleIconScopedRifleMap.png
  - typeSingle: RoleIconCrosshair
    fileSingle: Resources/DX/Roles/RoleIconCrosshair.png
  - typeSingle: RoleIconCrosshairMap
    fileSingle: Resources/DX/Roles/RoleIconCrosshairMap.png
  - typeSingle: RoleIconBinoculars
    fileSingle: Resources/DX/Roles/RoleIconBinoculars.png
  - typeSingle: RoleIconBinocularsMap
    fileSingle: Resources/DX/Roles/RoleIconBinocularsMap.png
  - typeSingle: RoleIconShotgun
    fileSingle: Resources/DX/Roles/RoleIconShotgun.png
  - typeSingle: RoleIconShotgunMap
    fileSingle: Resources/DX/Roles/RoleIconShotgunMap.png
  - typeSingle: RoleIconAmmoBelt
    fileSingle: Resources/DX/Roles/RoleIconAmmoBelt.png
  - typeSingle: RoleIconAmmoBeltMap
    fileSingle: Resources/DX/Roles/RoleIconAmmoBeltMap.png
  - typeSingle: RoleIconFist
    fileSingle: Resources/DX/Roles/RoleIconFist.png
  - typeSingle: RoleIconFistMap
    fileSingle: Resources/DX/Roles/RoleIconFistMap.png
  - typeSingle: RoleIconBrokenShield
    fileSingle: Resources/DX/Roles/RoleIconBrokenShield.png
  - typeSingle: RoleIconBrokenShieldMap
    fileSingle: Resources/DX/Roles/RoleIconBrokenShieldMap.png
  - typeSingle: RoleIconRocket
    fileSingle: Resources/DX/Roles/RoleIconRocket.png
  - typeSingle: RoleIconRocketMap
    fileSingle: Resources/DX/Roles/RoleIconRocketMap.png
  - typeSingle: RoleIconGrenade
    fileSingle: Resources/DX/Roles/RoleIconGrenade.png
  - typeSingle: RoleIconGrenadeMap
    fileSingle: Resources/DX/Roles/RoleIconGrenadeMap.png
  - typeSingle: RoleIconBomb
    fileSingle: Resources/DX/Roles/RoleIconBomb.png
  - typeSingle: RoleIconBombMap
    fileSingle: Resources/DX/Roles/RoleIconBombMap.png
  - typeSingle: RoleIconMedicalCross
    fileSingle: Resources/DX/Roles/RoleIconMedicalCross.png
  - typeSingle: RoleIconMedicalCrossMap
    fileSingle: Resources/DX/Roles/RoleIconMedicalCrossMap.png
  - typeSingle: RoleIconWaves
    fileSingle: Resources/DX/Roles/RoleIconWaves.png
  - typeSingle: RoleIconWavesMap
    fileSingle: Resources/DX/Roles/RoleIconWavesMap.png
  - typeSingle: RoleIconBolt
    fileSingle: Resources/DX/Roles/RoleIconBolt.png
  - typeSingle: RoleIconBoltMap
    fileSingle: Resources/DX/Roles/RoleIconBoltMap.png

# =====================================================================
#  Role-icon registry (same names as xcom1, so saves/mods line up).
# =====================================================================
  # DX stealth: an eye with a slash through it - "unseen".
  - typeSingle: RoleIconSlashedEye
    fileSingle: Resources/DX/Roles/RoleIconSlashedEye.png
  - typeSingle: RoleIconSlashedEyeMap
    fileSingle: Resources/DX/Roles/RoleIconSlashedEyeMap.png

roleIcons:
  - name: NONE
    sprite: RoleIconNone
  - name: RIFLE
    sprite: RoleIconRifle
    mapSprite: RoleIconRifleMap
  - name: SCOPED_RIFLE
    sprite: RoleIconScopedRifle
    mapSprite: RoleIconScopedRifleMap
  - name: CROSSHAIR
    sprite: RoleIconCrosshair
    mapSprite: RoleIconCrosshairMap
  - name: BINOCULARS
    sprite: RoleIconBinoculars
    mapSprite: RoleIconBinocularsMap
  - name: SHOTGUN
    sprite: RoleIconShotgun
    mapSprite: RoleIconShotgunMap
  - name: AMMO_BELT
    sprite: RoleIconAmmoBelt
    mapSprite: RoleIconAmmoBeltMap
  - name: FIST
    sprite: RoleIconFist
    mapSprite: RoleIconFistMap
  - name: BROKEN_SHIELD
    sprite: RoleIconBrokenShield
    mapSprite: RoleIconBrokenShieldMap
  - name: ROCKET
    sprite: RoleIconRocket
    mapSprite: RoleIconRocketMap
  - name: GRENADE
    sprite: RoleIconGrenade
    mapSprite: RoleIconGrenadeMap
  - name: BOMB
    sprite: RoleIconBomb
    mapSprite: RoleIconBombMap
  - name: MEDICAL_CROSS
    sprite: RoleIconMedicalCross
    mapSprite: RoleIconMedicalCrossMap
  - name: WAVES
    sprite: RoleIconWaves
    mapSprite: RoleIconWavesMap
  - name: BOLT
    sprite: RoleIconBolt
    mapSprite: RoleIconBoltMap

# =====================================================================
#  Soldier armor colours - TFTD tactical-palette values.
#  TFTD's tactical palette has a different block layout than UFO's, so
#  this set is authored against it (see the palette reference: block 3 =
#  greyscale, 5 = lime, 6 = aqua, 8 = gold, 10 = orange, 11 = orange-red,
#  12 = blue-grey, 14 = pink, 15 = cyan). Low nibble selects the recolor
#  mode: 1 = lighten, 15 = darken, else plain offset. TFTD has no purple
#  ramp, so the purple names are omitted here. FIRST-GUESS VALUES - tune
#  in play (deep-water palette variants tint all ramps bluer).
# =====================================================================
  - name: SLASHED_EYE
    sprite: RoleIconSlashedEye
    mapSprite: RoleIconSlashedEyeMap

soldierArmorBaseColors:
  - name: STR_COLOR_WHITE
    color: 49            # block 3 greyscale, lighten
  - name: STR_COLOR_GRAY
    color: 48            # block 3 greyscale
  - name: STR_COLOR_BLACK
    color: 63            # block 3 greyscale, darken
  - name: STR_COLOR_LIGHT_RED
    color: 177           # block 11 orange-red, lighten
  - name: STR_COLOR_RED
    color: 176           # block 11 orange-red
  - name: STR_COLOR_DARK_RED
    color: 191           # block 11 orange-red, darken
  - name: STR_COLOR_ORANGE
    color: 161           # block 10 orange/amber, lighten
  - name: STR_COLOR_GOLD
    color: 128           # block 8 gold->green
  - name: STR_COLOR_YELLOW
    color: 17            # block 1 yellow->green, lighten
  - name: STR_COLOR_LIGHT_GREEN
    color: 81            # block 5 lime, lighten
  - name: STR_COLOR_GREEN
    color: 80            # block 5 lime
  - name: STR_COLOR_DARK_GREEN
    color: 95            # block 5 lime, darken
  - name: STR_COLOR_BLUE_GREEN
    color: 96            # block 6 aqua/teal
  - name: STR_COLOR_LIGHT_BLUE
    color: 241           # block 15 cyan, lighten
  - name: STR_COLOR_BLUE
    color: 192           # block 12 blue-grey
  - name: STR_COLOR_NAVY
    color: 207           # block 12 blue-grey, darken
  - name: STR_COLOR_PINK
    color: 225           # block 14 pink/rose, lighten
  - name: STR_COLOR_BEIGE
    color: 32            # block 2 cream/khaki
  - name: STR_COLOR_BROWN
    color: 64            # block 4 brown

# =====================================================================
#  Armor accent blocks - measured from the actual TFTD sprite sheets
#  (dominant non-face/hair block; TFTD armors use face group 14 / hair
#  group 4):
#    TDXCOM_0 wetsuit        -> block 15 (74%, cyan)
#    TDXCOM_1 plastic aqua   -> block 12 (56%, blue-grey/white)
#    TDXCOM_2 ion + mag ion  -> block  8 (67%, gold)
# =====================================================================
armors:
  - type: STR_NONE_UC
    spriteUtileGroup: 15
  - type: STR_PLASTIC_AQUA_ARMOR_UC
    spriteUtileGroup: 12
  - type: STR_ION_ARMOR_UC
    spriteUtileGroup: 8
  - type: STR_MAGNETIC_ION_ARMOR_UC
    spriteUtileGroup: 8

# =====================================================================
#  Default seed roles - same set as xcom1; colours mapped to the nearest
#  TFTD equivalents (no purple ramp: Assault -> Light Blue, Psion -> Pink).
# =====================================================================
roles:
  - name: STR_ROLE_INFANTRY
    shortName: INF
    icon: RIFLE
    color: 192           # Blue
  - name: STR_ROLE_MARKSMAN
    shortName: MRK
    icon: SCOPED_RIFLE
    color: 48            # Gray
  - name: STR_ROLE_SNIPER
    shortName: SNP
    icon: CROSSHAIR
    color: 63            # Black
  - name: STR_ROLE_SCOUT
    shortName: SCT
    icon: BINOCULARS
    color: 17            # Yellow
  - name: STR_ROLE_ASSAULT
    shortName: ASL
    icon: SHOTGUN
    color: 241           # Light Blue
  - name: STR_ROLE_MACHINE_GUNNER
    shortName: MGN
    icon: AMMO_BELT
    color: 95            # Dark Green
  - name: STR_ROLE_HEAVY
    shortName: HVY
    icon: FIST
    color: 64            # Brown
  - name: STR_ROLE_ANTI_ARMOR
    shortName: AAR
    icon: BROKEN_SHIELD
  - name: STR_ROLE_ROCKETEER
    shortName: RKT
    icon: ROCKET
    color: 176           # Red
  - name: STR_ROLE_GRENADIER
    shortName: GRN
    icon: GRENADE
    color: 161           # Orange
  - name: STR_ROLE_DEMOLITIONS
    shortName: DEM
    icon: BOMB
  - name: STR_ROLE_MEDIC
    shortName: MED
    icon: MEDICAL_CROSS
    color: 49            # White
  - name: STR_ROLE_PSIONICS
    shortName: PSI
    icon: WAVES
    color: 225           # Pink
  - name: STR_ROLE_SPECIALIST
    shortName: SPC
    icon: BOLT

# Seed-role display names live in Language/DX/en-US.yml (shared with xcom1).
