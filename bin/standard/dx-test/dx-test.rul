# =====================================================================
#  DX Test Content
# =====================================================================
#  A scratch ruleset for testing OpenXcom DX combat features against
#  stock UFO. Everything here only tweaks existing xcom1 items, so it is
#  fully reversible: disable the mod to get the vanilla weapons back.
#
#  Add new throwaway test content below as DX features land.
# =====================================================================

# =====================================================================
#  DX: editable base damage types (loadEarlyRules pre-pass)
#  Give every PHYSICAL damage type the same armor-wear profile so the
#  Armor Degradation feature can be exercised across weapon types at
#  once. Special types are intentionally excluded: DT_IN (fire),
#  DT_STUN, DT_SMOKE (no normal armor interaction) and DT_NONE.
#  Edited here once instead of per-item damageAlter on every weapon.
#
#  Profile applied to AP / HE / LASER / PLASMA / MELEE:
#    ToArmor: 0.2                 # clean-penetration wear (power * 0.2)
#    ToArmorBlocked: 0.05         # blocked-hit wear ((origPower - armor*0.5) * 0.05 + 1)
#    ToArmorBlockedThreshold: 0.5
#    ToArmorOverPen: 1.0          # smash-through extra wear (power - armor)
#    ToArmorOverPenThreshold: 2.0
# =====================================================================
damageTypes:
  - ResistType: 1                # DT_AP
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 3                # DT_HE
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 4                # DT_LASER
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 5                # DT_PLASMA
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 7                # DT_MELEE
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0

items:
  # -------------------------------------------------------------------
  #  Pistol -> auto-firing shotgun
  #  Tests: async shotgun pellets flying as individual projectiles,
  #         shotgun spread, and timer-based burst cadence all at once.
  #  Fire the auto shot and watch the pellet fan fly out per round.
  # -------------------------------------------------------------------
  - type: STR_PISTOL
    shotgunChoke: 100      # DX: tightness of the pellet cone (with shotgunBehavior 1)
    fireInterval: 80       # DX: ms between burst shots (lower = more rounds airborne)
    autoShots: 3
    accuracyAuto: 50
    tuAuto: 33
    statModifiers:
      reactions: 25        # DX: +25% reactions (0 baseline)

  - type: STR_PISTOL_CLIP
    shotgunPellets: 6      # DX: launches 6 real projectiles per shot
    shotgunBehavior: 0     # 0 = diminishing-accuracy spread (vanilla-like), 1 = spread+choke
    shotgunSpread: 100     # spread width (100 = vanilla baseline)

  # -------------------------------------------------------------------
  #  Rifle -> long fast-cadence auto fire (non-shotgun)
  #  Tests: many normal bullets overlapping in flight via fireInterval.
  #  Also adds Burst: a fourth fire mode (3-round controlled volley)
  #  sitting between snap and auto. Opt-in via accuracyBurst.
  # -------------------------------------------------------------------
  - type: STR_RIFLE
    fireInterval: 60       # DX: very fast cadence to keep several rounds visible at once
    # --- Aimed ---
    accuracyAimed: 110
    tuAimed: 80
    aimRange: 200
    # --- Snap ---
    accuracySnap: 60
    tuSnap: 25
    snapRange: 15
    # --- Burst (DX): controlled 3-round volley between snap and auto ---
    accuracyBurst: 45      # DX: enables the Burst fire mode (per-shot, above auto, below snap)
    tuBurst: 33            # DX: TU cost (percentage of unit TUs) - between snap and auto
    burstShots: 3          # DX: 3-round controlled volley
    burstRange: 12         # DX: effective range band
    ## --- Auto: high-volume suppression spray ---
    ## vanilla STR_RIFLE Auto: accuracyAuto 35, tuAuto 35, autoShots 3 (autoRange 7)
    ##accuracyAuto: 30       # was 35 - low per-shot accuracy to offset the round count
    ##tuAuto: 50             # was 35 - pricier than burst for the longer volley
    ##autoShots: 6           # was 3  - now a 6-round auto burst
    ##autoRange: 7           # unchanged (engine default)
    # --- Auto: Many shots with high accuracy to test async projectile flight ---
    accuracyAuto: 200      # DX: high per-shot accuracy to see many rounds in flight
    tuAuto: 20             # DX: low TU cost to allow many rounds in a single turn
    autoRange: 200         # DX: long range to allow many rounds hitting multiple targets in a line
    autoShots: 10          # DX: many rounds in a single turn to test async projectile flight

  # -------------------------------------------------------------------
  #  Basic grenade -> full radius falloff
  #  Tests: blastDropoff at 100% (center strong, edge minimal/zero)
  # -------------------------------------------------------------------
  - type: STR_GRENADE
    blastDropoff: 1.0

  # -------------------------------------------------------------------
  #  Rocket launcher -> TU penalty test item
  #  Tests: flat TU penalty using item stats
  # -------------------------------------------------------------------
  - type: STR_ROCKET_LAUNCHER
    stats:
      tu: -10

# =====================================================================
#  DX: configurable inventory layouts (per-armor)
#  Exercises RuleInventoryLayout + Armor.inventoryLayout. Each soldier
#  armor below gets a different layout so you can swap armor in the base
#  and watch the inventory grid change.
#
#    STR_NONE_UC          -> LIGHT  (hands + ground + 3 typed test slots; no belt)
#    STR_PERSONAL_ARMOR_UC-> RIG    (no backpack; adds a "satchel" slot)
#    STR_POWER_SUIT_UC    -> CLONE  (refNode-inherits LIGHT; renders == LIGHT)
#    STR_FLYING_SUIT_UC   -> ONEHAND (locked "integrated weapon" hand + belt; no left hand)
#
#  What to check:
#    * LIGHT: backpack/legs/shoulders AND the belt are gone; auto-equip never fills
#      them; you cannot drop items there; hands/ground still work. Plus three DX
#      typed test slots: an AMMO pouch (clips only), a HOLSTER (firearms only), and
#      a LOCKER (un-unequippable in combat). Try mis-placing items: a pistol in the
#      AMMO pouch or a clip in the HOLSTER is rejected with STR_INVALID_ITEM_SLOT.
#      For the LOCKER, stow something pre-battle, then in combat you can lift it but
#      can't move it to another slot or drop anything in (STR_NOT_COMBAT_SWAPPABLE).
#    * RIG: the satchel slot draws to the right and accepts items by
#      hand (manual placement); backpack is absent. The satchel is countStats:false,
#      so a stat-granting item stowed there grants NO bonus (move it to a hand/belt
#      slot and the bonus reappears) - check via the soldier's stats.
#    * CLONE: power-suit inventory looks identical to LIGHT (hands+belt+ground),
#      proving refNode inheritance loaded the parent's sections. (If refNode
#      failed, you'd see only the ground slot.)
#    * ONEHAND: the only hand is a locked "integrated WEAPON" mount (a renamed,
#      non-STR_RIGHT_HAND section flagged hand: right) + belt + ground. Tests three
#      things at once: (1) configurable hand slots - a firearm still auto-equips here,
#      fires, and reacts even though the section isn't STR_RIGHT_HAND; (2) the
#      battleType filter - only firearms fit (a clip/grenade is rejected); (3)
#      allowCombatSwap:false - in combat you can't pull the weapon out. Also
#      exercises the missing-left-hand unload/reload fallbacks (ejected clips go to
#      belt/ground since there's no off-hand).
# =====================================================================
# The DX typed-slot test sections are normal global `invs:` sections. They're simply not listed
# in STR_STANDARD_INV, so they only appear in the layouts below that name them (not on every unit).
invs:
  # AMMO-ONLY pouch (2 wide). battleType 2 = BT_AMMO -> only clips fit; a weapon/grenade is
  # rejected (STR_INVALID_ITEM_SLOT), and auto-equip won't dump non-ammo here.
  - id: STR_DX_AMMO_POUCH
    x: 16
    y: 37
    type: 0
    battleType: 2
    slots: [ [0, 0], [1, 0] ]
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_GROUND: 6
  # WEAPON-ONLY "holster" (1 wide, 2 tall). battleType 1 = BT_FIREARM -> only firearms fit
  # (e.g. the pistol); ammo, grenades, etc. are rejected.
  - id: STR_DX_HOLSTER
    x: 192
    y: 104
    type: 0
    battleType: 1
    slots: [ [0, 0], [0, 1] ]
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 1     # quick-draw: 1 TU to whip the holstered weapon into the left hand
      STR_GROUND: 6
  # un-unequippable "locker" backpack (2x2) in the normal backpack zone. allowCombatSwap:
  # false -> load it freely on the pre-battle equip screen, but once combat is underway you
  # can't move an item into OR out of it (STR_NOT_COMBAT_SWAPPABLE) - including ctrl-click to ground.
  - id: STR_DX_LOCKER
    x: 192
    y: 37
    type: 0
    allowCombatSwap: false
    slots: [ [0, 0], [1, 0], [0, 1], [1, 1] ]
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_GROUND: 6
  # 3x2 "satchel" where the backpack used to be. countStats: false -> items stowed here grant
  # NO stat/statModifier bonus (the same item in a hand/belt slot still grants its bonus).
  - id: STR_DX_SATCHEL
    x: 192
    y: 37
    type: 0
    countStats: false
    slots: [ [0, 0], [1, 0], [2, 0], [0, 1], [1, 1], [2, 1] ]
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_BELT: 12
      STR_GROUND: 10
  # An "integrated weapon" hand: a built-in gun mount used as the unit's right hand. It is a real
  # hand (hand: right -> auto-equips firearms, fires, reacts), only accepts firearms
  # (battleType 1 = BT_FIREARM), and is locked once combat starts (allowCombatSwap: false) so the
  # weapon can't be removed/swapped mid-mission. Sits in the normal right-hand spot.
  - id: STR_DX_INTEGRATED_WEAPON
    x: 0
    y: 63
    type: 1                 # INV_HAND
    hand: right
    battleType: 1           # firearms only
    allowCombatSwap: false  # integrated: can't be pulled out or swapped in combat
    costs:
      STR_BELT: 8
      STR_GROUND: 2

inventoryLayouts:
  - id: STR_DX_LAYOUT_LIGHT
    invs: &dxLightInvs [STR_RIGHT_HAND, STR_LEFT_HAND, STR_GROUND, STR_DX_AMMO_POUCH, STR_DX_HOLSTER, STR_DX_LOCKER]

  - id: STR_DX_LAYOUT_RIG
    invs: [STR_RIGHT_HAND, STR_LEFT_HAND, STR_BELT, STR_RIGHT_SHOULDER, STR_LEFT_SHOULDER, STR_GROUND, STR_DX_SATCHEL]

  - id: STR_DX_LAYOUT_CLONE
    # refNode reuse: inherit LIGHT's invs list verbatim (no own `invs:`), so this renders
    # identical to LIGHT. Demonstrates the standard refNode mechanic.
    refNode:
      invs: *dxLightInvs

  - id: STR_DX_LAYOUT_ONEHAND
    # The unit's only hand is a locked "integrated weapon" mount (firearms only, can't be removed
    # in combat). No left hand. Exercises configurable hand slots (a renamed, non-STR_RIGHT_HAND
    # section acting as the right hand) plus the typed-slot battleType/allowCombatSwap filters, and
    # the missing-left-hand unload/reload fallbacks.
    invs: [STR_DX_INTEGRATED_WEAPON, STR_BELT, STR_GROUND]

armors:
  - type: STR_NONE_UC
    inventoryLayout: STR_DX_LAYOUT_LIGHT
  - type: STR_PERSONAL_ARMOR_UC
    inventoryLayout: STR_DX_LAYOUT_RIG
  - type: STR_POWER_SUIT_UC
    inventoryLayout: STR_DX_LAYOUT_CLONE
  - type: STR_FLYING_SUIT_UC
    inventoryLayout: STR_DX_LAYOUT_ONEHAND

extraStrings:
  - type: en-US
    strings:
      STR_DX_SATCHEL: "SATCHEL"
      STR_DX_AMMO_POUCH: "AMMO"
      STR_DX_HOLSTER: "HOLSTER"
      STR_DX_LOCKER: "LOCKER"
      STR_DX_INTEGRATED_WEAPON: "WEAPON"

# =====================================================================
#  User options forced on while this test mod is active
# =====================================================================
fixedUserOptions:
  combatLogVerbose: true   # DX: extra detail in the combat log (hidden option)

