# =====================================================================
#  DX Test Content
# =====================================================================
#  A scratch ruleset for testing OpenXcom DX combat features against
#  stock UFO. Everything here only tweaks existing xcom1 items, so it is
#  fully reversible: disable the mod to get the vanilla weapons back.
#
#  Add new throwaway test content below as DX features land.
# =====================================================================

# =====================================================================
#  DX: mod-wide default armor move costs. Exercises the moveCostDefaults
#  feature - these apply to every armor that doesn't set its own moveCost,
#  so stock soldiers get slow sneaking and ground-covering sprints without
#  editing each armor. Each value is [time%, energy%] per tile.
# =====================================================================
moveCostDefaults:
  sneakPercent: [200, 50]   # sneak: double TU per tile (slow), same energy as walking
  runPercent:   [50, 100]   # sprint: half TU (fast, covers ground), double walking's energy

# =====================================================================
#  DX: mod-wide defaults for how sprint/sneak scale a moving unit's
#  DEFENSIVE evasion (reaction-fire resistance). Percent, 100 = no change.
#  Armors override per-unit via evasionSprint / evasionSneak.
# =====================================================================
evasionDefaults:
  # sprint: half the reactions stat, but only half the TU/maxTU penalty (fast movers stay a bit
  # evasive even when low on TU); net effect - more exposed at full TU, less punished when depleted.
  sprint: { statPercent: 60,  tuPenaltyPercent: 50 }
  # sneak: full reactions stat at ALL times (no TU penalty) - always alert, hard to react-fire against.
  sneak:  { statPercent: 90, tuPenaltyPercent: 0 }

# =====================================================================
#  DX: mod-wide default overwatch config. Because overwatchRange > 0, this
#  ENABLES overwatch on every weapon that doesn't set its own overwatch*
#  fields (range 0 = off is the engine default). The rifle and heavy sniper
#  below override these with their own per-weapon tuning.
# =====================================================================
overwatchDefaults:
  overwatchMinRange:  5      # blind within 5 tiles
  overwatchRange:     20     # watch out to 20 tiles
  overwatchConeAngle: 30     # 30-degree cone (full width)
  overwatchShot:      aimed  # reserve aimed shots
  overwatchModifier:  80     # 80% of the offensive reaction score

# =====================================================================
#  DX: mod-wide bleedout config. A soldier crossing 0 HP bleeds out instead
#  of dying, and only dies once health reaches -deathHealthPercent% of max.
# =====================================================================
bleedoutDefaults:
  deathHealthPercent: 50     # die at -maxHealth/2 (matches the engine default)
  bufferWounds:       5      # fatal torso wounds added on entering bleedout

# =====================================================================
#  DX: editable base damage types (loadEarlyRules pre-pass)
#  Give every PHYSICAL damage type the same armor-wear profile so the
#  Armor Degradation feature can be exercised across weapon types at
#  once. Special types are intentionally excluded: DT_IN (fire),
#  DT_STUN, DT_SMOKE (no normal armor interaction) and DT_NONE.
#  Edited here once instead of per-item damageAlter on every weapon.
#
#  Profile applied to AP / HE / LASER / PLASMA / MELEE:
#    ToArmor: 0.2                 # clean-penetration wear (power * 0.2)
#    ToArmorBlocked: 0.05         # blocked-hit wear ((origPower - armor*0.5) * 0.05 + 1)
#    ToArmorBlockedThreshold: 0.5
#    ToArmorOverPen: 1.0          # smash-through extra wear (power - armor)
#    ToArmorOverPenThreshold: 2.0
# =====================================================================
damageTypes:
  - ResistType: 1                # DT_AP
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 3                # DT_HE
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 4                # DT_LASER
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 5                # DT_PLASMA
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0
  - ResistType: 7                # DT_MELEE
    ToArmor: 0.2
    ToArmorBlocked: 0.05
    ToArmorBlockedThreshold: 0.5
    ToArmorOverPen: 1.0
    ToArmorOverPenThreshold: 2.0

items:

# =====================================================================
#  DX: aim-cone trajectory model (baseAccuracy opt-in)
#  Opts the starter conventional weapons into the aim-cone firing model
#  (plans/Feature-AimConeTrajectory.md). baseAccuracy > 0 switches the
#  weapon from the native scatter model to the two-cone model and sets
#  the weapon cone's width: 75 = calibration reference (~0.5 deg sigma),
#  lower = sloppier, higher = tighter. Weapon-cone sigmas for the values
#  below (soldier aim error stacks on top):
#    45 -> ~1.4 deg   55 -> ~0.9 deg   65 -> ~0.7 deg
#    70 -> ~0.6 deg   85 -> ~0.4 deg   150 -> ~0.1 deg
#
#  What to check:
#    * Rifle vs pistol at range: same soldier, snap shots at 15+ tiles -
#      the rifle should land noticeably more hits; up close (<8 tiles)
#      they should feel similar (soldier cone dominates).
#    * Auto-cannon bursts walk around the target (every round re-rolls
#      both cones) and spray hard at distance.
#    * Heavy sniper (reframed heavy cannon): baseAccuracy 150 makes the
#      weapon cone negligible, so an AIMED shot's reach is set almost
#      entirely by the shooter's skill. A high-Firing soldier should tag
#      targets at extreme range that every other weapon here misses; its
#      snap is deliberately bad (don't hip-fire a sniper). This is the
#      top-end counterpart to the auto-cannon's wide spray.
#    * Misses streak past/over the target toward the horizon instead of
#      landing in a disc around it; miss spread visibly grows with range.
#    * Rocket launcher misses still sail somewhere plausible downrange
#      (3-sigma clamp - no backwards rockets).
#    * Vanilla dropoff no longer applies to these six (aim/snap/auto
#      range fields are inert on the cone path, even with UFOExtender
#      Accuracy on).
# =====================================================================
  - type: STR_PISTOL
    baseAccuracy: 55        # sloppy sidearm: short-range weapon, loose pattern
    # DX overwatch: a wide, mid-range sweep - a sidearm covering a broad arc close/mid, snap shots.
    overwatchRange: 12       # mid range
    overwatchMinRange: 0     # covers right up close
    overwatchConeAngle: 100  # very wide (full width)
    overwatchShot: snap
  - type: STR_RIFLE
    baseAccuracy: 85        # precision rifle: tightest of the conventional set
    # Multi-shot testing: auto becomes a long 6-round spray and costs more (45TU, up
    # from vanilla 35), with a new DX Burst mode (3 rounds) taking auto's old slot:
    # snap 25TU/60% -> burst 35TU/45% -> auto 45TU/35%. Every round of a spray/burst
    # re-rolls BOTH cones, so autos/bursts should visibly walk around the target.
    autoShots: 6
    tuAuto: 45
    tuBurst: 35
    accuracyBurst: 45
    burstShots: 3
    # DX overwatch test: a fairly narrow, long watch cone with a small near dead-zone. Select
    # "Overwatch" from the rifle's action menu, click a tile to aim the cone (yellow tile markers show
    # the watched area), and enemies entering it on their turn draw a reserved snap shot.
    overwatchRange: 20       # watch out to 20 tiles
    overwatchMinRange: 2     # ignore the 2-tile near dead zone
    overwatchConeAngle: 50   # 50-degree cone (full width)
    overwatchShot: burst     # reserve burst shots
    overwatchModifier: 110   # +10% offensive reaction score on the overwatch shot
  - type: STR_AUTO_CANNON
    baseAccuracy: 45        # spray support gun: widest cone of the set
  - type: STR_HEAVY_CANNON  # reframed as a heavy sniper (renamed in extraStrings below)
    baseAccuracy: 150       # laser-precise weapon cone (~0.1 deg): at range the shot is
                            # limited almost entirely by the shooter's aim, not the gun
    accuracySnap: 40        # poor hip-fire...
    tuSnap: 45              # ...and expensive: a genuine last resort
    accuracyAimed: 150      # the star: a big deliberate-aim bonus that tightens the SOLDIER
    tuAimed: 80             #   cone hard, so a skilled sniper reaches far out
    # DX overwatch test - sniper "watch a lane": a long, narrow cone with a big near dead zone, firing
    # the precise AIMED shot. Contrast with the rifle's short/wide burst overwatch. The aimed shot is
    # expensive (80 TU), so after the free reserved shot it typically manages just one more per turn.
    overwatchRange: 40       # watches all the way downrange
    overwatchMinRange: 10    # blind up close - it only covers the far lane
    overwatchConeAngle: 20   # very narrow 20-degree cone (full width)
    overwatchShot: aimed     # the sniper's deliberate aimed shot
    overwatchModifier: 120   # +20% - a set, watching sniper is quick to squeeze
  - type: STR_ROCKET_LAUNCHER
    baseAccuracy: 70        # aimed launcher: near reference precision

# ---------------------------------------------------------------------
#  DX: test shotgun (new item; borrows the rifle's graphics and size).
#  Exercises the aim-cone shotgun rules: the whole volley shares ONE
#  soldier-cone roll (the pattern's center moves shot to shot), then each
#  pellet rolls its own weapon cone scaled by the ammo's shotgunSpread.
#  shotgunChoke/shotgunBehaviorType are deliberately unset - they don't
#  apply on the cone path (choke is subsumed by baseAccuracy).
#
#  What to check:
#    * Buckshot: 6-pellet cloud; pellet cluster lands together around a
#      center that wanders with the shooter's aim error. Devastating
#      close, pellets spread wide at range (spread 150 = 1.5x weapon cone).
#    * Slug: single round, tighter than buckshot (spread doesn't apply -
#      no pellets), hits like a heavy rifle round.
#    * Same gun, same soldier: buckshot vs slug should pattern visibly
#      differently - that's the per-ammo spread axis working.
# ---------------------------------------------------------------------
  - type: STR_SHOTGUN
    size: 0.2
    costBuy: 2000
    costSell: 1500
    weight: 8
    bigSprite: 1            # rifle graphics
    floorSprite: 1
    handSprite: 0
    bulletSprite: 2
    fireSound: 4
    compatibleAmmo:
      - STR_SHOTGUN_BUCKSHOT
      - STR_SHOTGUN_SLUG
    accuracySnap: 55
    accuracyAimed: 85
    tuSnap: 25
    tuAimed: 55
    battleType: 1
    twoHanded: true
    invWidth: 1
    invHeight: 3
    baseAccuracy: 65        # decent smoothbore: between heavy cannon (60) and launcher (70)
    # DX overwatch: a short-range wide watch - covers a doorway/room, snap shots.
    overwatchRange: 12        # short range
    overwatchMinRange: 0     # covers right up close
    overwatchConeAngle: 70   # wide
    overwatchShot: aimed
  - type: STR_SHOTGUN_BUCKSHOT
    size: 0.1
    costBuy: 250
    costSell: 180
    weight: 3
    bigSprite: 2            # rifle clip graphics
    floorSprite: 2
    hitSound: 22
    hitAnimation: 26
    power: 20               # per pellet (6 pellets = up to 120 total up close)
    damageType: 1
    clipSize: 8
    battleType: 2
    shotgunPellets: 6
    shotgunSpread: 150      # per-pellet weapon cone x1.5 (100 = neutral)
  - type: STR_SHOTGUN_SLUG
    size: 0.1
    costBuy: 300
    costSell: 220
    weight: 3
    bigSprite: 4            # pistol clip graphics (distinguishes slugs from buckshot)
    floorSprite: 4
    hitSound: 22
    hitAnimation: 26
    power: 45               # single heavy round
    damageType: 1
    # DX battleClipSize test: slugs are stocked / bought / sold / recovered ONE round at a time
    # (each store unit is a single slug), but they load as an 8-round magazine in the field. Compare
    # with STR_SHOTGUN_BUCKSHOT above (normal clipSize: 8 - bought and recovered as whole 8-round clips).
    # battleClipSize forces clipSize to 0, so the two models are mutually exclusive.
    battleClipSize: 8
    battleType: 2

# =====================================================================
#  DX: configurable inventory layouts (per-armor)
#  Exercises RuleInventoryLayout + Armor.inventoryLayout. Each soldier
#  armor below gets a different layout so you can swap armor in the base
#  and watch the inventory grid change.
#
#    STR_NONE_UC          -> LIGHT  (hands + ground + 3 typed test slots; no belt)
#    STR_PERSONAL_ARMOR_UC-> RIG    (no backpack; adds a "satchel" slot)
#    STR_POWER_SUIT_UC    -> POWER  (LIGHT test slots, but a full backpack instead of the medkit slot)
#    STR_FLYING_SUIT_UC   -> ONEHAND (locked "integrated weapon" hand + belt; no left hand)
#
#  What to check:
#    * LIGHT: backpack/legs/shoulders AND the belt are gone; auto-equip never fills
#      them; you cannot drop items there; hands/ground still work. Plus three DX
#      typed test slots: an AMMO pouch (an EQUIP-type 2x1 box, one clip only), a HOLSTER (firearms only), and
#      a MEDKIT (a UTILITY-type 2x2 box, medikits only). Try mis-placing items: a pistol in the
#      AMMO pouch, a clip in the HOLSTER, or a non-medikit in the MEDKIT slot is rejected with
#      STR_INVALID_ITEM_SLOT. The MEDKIT is single-occupant and is the unit's getUtilityItem() slot;
#      it's allowCombatSwap:false, so stow a medikit pre-battle, then in combat you can't move it
#      in/out of the slot (STR_NOT_COMBAT_SWAPPABLE) - it's meant to be used in place. Press the
#      Use-Utility key (default Z) in combat to open its action menu and heal from the slot; note
#      the Throw action is NOT offered (blocked for utility + combat-locked slots).
#    * RIG: the satchel slot draws to the right and accepts items by
#      hand (manual placement); backpack is absent. The satchel is countStats:false,
#      so a stat-granting item stowed there grants NO bonus (move it to a hand/belt
#      slot and the bonus reappears) - check via the soldier's stats. RIG also has a
#      UTILITY slot (INV_UTILITY, type 3, top-right): a single-occupant hand-family box
#      that only accepts a flare (battleType BT_FLARE) and grants no wield (the item is
#      not held in hand). Drop a flare there - it fills the whole box; a non-flare is
#      rejected. This is the new utility-equipment-slot plumbing. RIG also has an EQUIP
#      slot (INV_EQUIP, type 4) with a RULE-DEFINED 2x1 box (width/height): a wide, short
#      box for gear, still single-occupant and size-checked (an item bigger than 2x1 is
#      rejected).
#    * CLONE: power-suit inventory looks identical to LIGHT (hands+belt+ground),
#      proving refNode inheritance loaded the parent's sections. (If refNode
#      failed, you'd see only the ground slot.)
#    * ONEHAND: the only hand is a locked "integrated WEAPON" mount (a renamed,
#      non-STR_RIGHT_HAND section flagged hand: right) + belt + ground. Tests three
#      things at once: (1) configurable hand slots - a firearm still auto-equips here,
#      fires, and reacts even though the section isn't STR_RIGHT_HAND; (2) the
#      battleType filter - only firearms fit (a clip/grenade is rejected); (3)
#      allowCombatSwap:false - in combat you can't pull the weapon out. Also
#      exercises the missing-left-hand unload/reload fallbacks (ejected clips go to
#      belt/ground since there's no off-hand).
# =====================================================================
# The DX typed-slot test sections are normal global `invs:` sections. They're simply not listed
# in STR_STANDARD_INV, so they only appear in the layouts below that name them (not on every unit).
invs:
  # AMMO-ONLY pouch, now an EQUIP slot (INV_EQUIP, type 4) with a rule-defined 2x1 box instead of
  # a slot grid: single-occupant (one clip, not two), size-checked. battleType 2 = BT_AMMO -> only
  # clips fit; a weapon/grenade is rejected (STR_INVALID_ITEM_SLOT), and auto-equip won't dump
  # non-ammo here.
  - id: STR_DX_AMMO_POUCH
    x: 16
    y: 37
    type: 4                 # INV_EQUIP
    width: 2                # rule-defined 2x1 box (overrides the EQUIP_W/EQUIP_H default)
    height: 1
    battleType: 2
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_GROUND: 6
  # WEAPON-ONLY "holster" (1 wide, 2 tall). battleType 1 = BT_FIREARM -> only firearms fit
  # (e.g. the pistol); ammo, grenades, etc. are rejected.
  - id: STR_DX_HOLSTER
    x: 192
    y: 104
    type: 0
    battleType: 1
    slots: [ [0, 0], [0, 1] ]
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 1     # quick-draw: 1 TU to whip the holstered weapon into the left hand
      STR_GROUND: 6
  # MEDIKIT-only utility slot (INV_UTILITY, 2x2) in the normal backpack zone. type: 3 -> a
  # single-occupant, non-wielded box (no slots: grid), size-checked to the 2x2 UTILITY default.
  # battleType 6 = BT_MEDIKIT -> only medikits fit; anything else is rejected. allowCombatSwap: false
  # -> the medikit is meant to be used in place but NOT moved in/out once combat is underway
  # (STR_NOT_COMBAT_SWAPPABLE). BattleUnit::getUtilityItem() returns whatever's here.
  - id: STR_DX_MEDKIT
    x: 192
    y: 37
    type: 3                 # INV_UTILITY (2x2 default box)
    battleType: 6           # medikits only (BT_MEDIKIT)
    allowCombatSwap: false  # usable in place, but locked in/out during combat
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_GROUND: 6
  # 3x2 "satchel" where the backpack used to be. countStats: false -> items stowed here grant
  # NO stat/statModifier bonus (the same item in a hand/belt slot still grants its bonus).
  - id: STR_DX_SATCHEL
    x: 192
    y: 37
    type: 0
    countStats: false
    slots: [ [0, 0], [1, 0], [2, 0], [0, 1], [1, 1], [2, 1] ]
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_BELT: 12
      STR_GROUND: 10
  # An "integrated weapon" hand: a built-in gun mount used as the unit's right hand. It is a real
  # hand (hand: right -> auto-equips firearms, fires, reacts), only accepts firearms
  # (battleType 1 = BT_FIREARM), and is locked once combat starts (allowCombatSwap: false) so the
  # weapon can't be removed/swapped mid-mission. Sits in the normal right-hand spot.
  - id: STR_DX_INTEGRATED_WEAPON
    x: 0
    y: 63
    type: 1                 # INV_HAND
    hand: right
    battleType: 1           # firearms only
    allowCombatSwap: false  # integrated: can't be pulled out or swapped in combat
    costs:
      STR_GROUND: 2
  # AMMO-ONLY "heavy ammo satchel": a big 4x3 slot grid (type 0) that replaces the belt in the
  # ONEHAND layout. battleType 2 = BT_AMMO -> only clips fit (a weapon/grenade is rejected,
  # STR_INVALID_ITEM_SLOT, and auto-equip won't dump non-ammo here). Sized to hold a deep
  # reserve of reloads for the single integrated weapon that has no off-hand to juggle clips.
  # Positioned where the left hand would normally sit (x:128, y:63), extending right.
  - id: STR_DX_AMMO_SATCHEL
    x: 128
    y: 63
    type: 0                 # INV_SLOT (grid)
    battleType: 2           # ammo only (BT_AMMO)
    slots:
      - [0, 0]
      - [1, 0]
      - [2, 0]
      - [3, 0]
      - [0, 1]
      - [1, 1]
      - [2, 1]
      - [3, 1]
      - [0, 2]
      - [1, 2]
      - [2, 2]
      - [3, 2]
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_GROUND: 6
  # A dedicated "utility" equipment slot (INV_UTILITY). type: 3 -> single-occupant box (one item,
  # no slots: grid needed), but it is NOT a hand: the item is never wielded/fired/reacted from, and
  # BattleUnit::getUtilityItem() returns whatever sits here. Unlike a hand it DOES size-check: only
  # items up to the 2x2 box (UTILITY_W x UTILITY_H) fit; a larger item is rejected. The typed-slot
  # rules still compose: battleType 10 = BT_FLARE -> only flares fit here.
  - id: STR_DX_UTILITY
    x: 256
    y: 37
    type: 3                 # INV_UTILITY
    battleType: 10          # flares only (BT_FLARE) - exercises typed-slot composition on a utility slot
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_BELT: 8
      STR_GROUND: 4
  # An "equipment" slot (INV_EQUIP, type: 4) for equippable gear (e.g. night-vision goggles).
  # Like utility it is a single-occupant, non-wielded box that size-checks its contents - but its
  # box size is RULE-DEFINED via width/height (not the fixed 2x2 default). Here it's a wide, short
  # 2x1 gear slot; an item taller/wider than 2x1 is rejected.
  - id: STR_DX_EQUIP
    x: 192
    y: 72
    type: 4                 # INV_EQUIP
    width: 2                # rule-defined box (cells); overrides the EQUIP_W/EQUIP_H default
    height: 1
    costs:
      STR_RIGHT_HAND: 8
      STR_LEFT_HAND: 8
      STR_BELT: 8
      STR_GROUND: 4

inventoryLayouts:
  - id: STR_DX_LAYOUT_LIGHT
    invs: &dxLightInvs [STR_RIGHT_HAND, STR_LEFT_HAND, STR_GROUND, STR_DX_AMMO_POUCH, STR_DX_HOLSTER, STR_DX_MEDKIT]

  - id: STR_DX_LAYOUT_RIG
    invs: [STR_RIGHT_HAND, STR_LEFT_HAND, STR_BELT, STR_RIGHT_SHOULDER, STR_LEFT_SHOULDER, STR_GROUND, STR_DX_SATCHEL]

  - id: STR_DX_LAYOUT_POWER
    # Power-armor loadout: the LIGHT test slots but with the full standard backpack in place of the
    # medkit slot (hands + ground + ammo pouch + holster + backpack).
    invs: [STR_RIGHT_HAND, STR_LEFT_HAND, STR_GROUND, STR_DX_AMMO_POUCH, STR_DX_HOLSTER, STR_BACK_PACK]

  - id: STR_DX_LAYOUT_ONEHAND
    # The unit's only hand is a locked "integrated weapon" mount (firearms only, can't be removed
    # in combat). No left hand. Exercises configurable hand slots (a renamed, non-STR_RIGHT_HAND
    # section acting as the right hand) plus the typed-slot battleType/allowCombatSwap filters, and
    # the missing-left-hand unload/reload fallbacks. Instead of a belt it carries a big 4x3
    # ammo-only satchel (STR_DX_AMMO_SATCHEL) - a deep clip reserve for the single integrated gun.
    invs: [STR_DX_INTEGRATED_WEAPON, STR_DX_AMMO_SATCHEL, STR_GROUND]

armors:
  - type: STR_NONE_UC
    inventoryLayout: STR_DX_LAYOUT_LIGHT
  - type: STR_PERSONAL_ARMOR_UC
    inventoryLayout: STR_DX_LAYOUT_RIG
    evasion: 200        # DX reaction-split test: 2x base defensive evasion (harder to react-fire against);
                        # its own reaction fire is unaffected (offence untouched)
    # per-armor override of the global sprint config: a nimble suit that keeps more of its reactions
    # and takes less TU penalty while sprinting than the mod-wide default {50, 50}.
    evasionSprint: { statPercent: 75, tuPenaltyPercent: 25 }
  - type: STR_POWER_SUIT_UC
    inventoryLayout: STR_DX_LAYOUT_POWER
  - type: STR_FLYING_SUIT_UC
    inventoryLayout: STR_DX_LAYOUT_ONEHAND

extraStrings:
  - type: en-US
    strings:
      STR_HEAVY_CANNON: "Heavy Sniper"
      STR_SHOTGUN: "Shotgun"
      STR_SHOTGUN_BUCKSHOT: "Shotgun Buckshot"
      STR_SHOTGUN_SLUG: "Shotgun Slug"
      STR_DX_SATCHEL: "SATCHEL"
      STR_DX_AMMO_POUCH: "AMMO"
      STR_DX_HOLSTER: "HOLSTER"
      STR_DX_MEDKIT: "MEDKIT"
      STR_DX_INTEGRATED_WEAPON: "WEAPON"
      STR_DX_AMMO_SATCHEL: "AMMO SATCHEL"

# =====================================================================
#  User options forced on while this test mod is active
# =====================================================================
fixedUserOptions:
  combatLogVerbose: false           # DX: extra detail in the combat log (hidden option)
  battleRealisticThrowing: true     # DX: physical launch-error throw accuracy (short/long along the throw line)
  battleWeightBasedReloadCost: true # DX: reload/unload timed by magazine weight (weight*2 + reduced base)

